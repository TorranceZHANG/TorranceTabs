{
  "manifest_version": 3,
  "name": "TorranceTabs · 标签管理",
  "version": "1.8.0",
  "minimum_chrome_version": "110",
  "description": "自动分组、实时标签搜索、可选侧栏、可预览去重、工作区历史与按需配置同步。",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "scripting",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "一键清理重复页 · 标签工具",
    "default_popup": "quick.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "deduplicate-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+Y"
      },
      "description": "一键清理重复标签页（相同完整网址保留一份）"
    },
    "favorite-1": {
      "suggested_key": {
        "default": "Alt+Shift+1",
        "mac": "MacCtrl+Shift+1"
      },
      "description": "定位或打开常用入口 1"
    },
    "favorite-2": {
      "suggested_key": {
        "default": "Alt+Shift+2",
        "mac": "MacCtrl+Shift+2"
      },
      "description": "定位或打开常用入口 2"
    },
    "favorite-3": {
      "suggested_key": {
        "default": "Alt+Shift+3",
        "mac": "MacCtrl+Shift+3"
      },
      "description": "定位或打开常用入口 3"
    },
    "open-search": {
      "description": "打开统一搜索"
    },
    "open-side-panel": {
      "description": "打开可选侧栏或标签看板"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "omnibox": {
    "keyword": "tt"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
