{
  "manifest_version": 3,
  "name": "TorranceTabs · 标签管理",
  "version": "1.7.2",
  "minimum_chrome_version": "110",
  "description": "网址前缀分组、可撤销去重、常用站点快捷入口、项目工作区与配置迁移。",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "一键清理重复页 · 标签工具",
    "default_popup": "quick.html"
  },
  "commands": {
    "deduplicate-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Command+Shift+Y"
      },
      "description": "一键清理重复标签页（相同完整网址保留一份）"
    },
    "favorite-1": {
      "suggested_key": {
        "default": "Alt+Shift+1",
        "mac": "MacCtrl+Shift+1"
      },
      "description": "定位或打开常用入口 1"
    },
    "favorite-2": {
      "suggested_key": {
        "default": "Alt+Shift+2",
        "mac": "MacCtrl+Shift+2"
      },
      "description": "定位或打开常用入口 2"
    },
    "favorite-3": {
      "suggested_key": {
        "default": "Alt+Shift+3",
        "mac": "MacCtrl+Shift+3"
      },
      "description": "定位或打开常用入口 3"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
